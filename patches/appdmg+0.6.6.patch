index 0000000..eca0f6c
--- /dev/null
+++ b/node_modules/appdmg/lib/image-size.js
@@ -0,0 +1,11 @@
+// Preserve appdmg's asynchronous filename API with the patched buffer parser.
+const fs = require('fs')
+const { imageSize } = require('image-size')
+module.exports = function sizeOf (filename, callback) {
+  fs.readFile(filename, (error, bytes) => {
+    if (error) return callback(error)
+    let dimensions
+    try { dimensions = imageSize(bytes) } catch (error) { return callback(error) }
+    callback(null, dimensions)
+  })
+}
